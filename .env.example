# ─── DATABASE CONFIGURATION (POSTGRESQL) ───
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here
DB_NAME=inventory_prod

# ─── BACKEND SERVER CONFIGURATION ───
PORT=5000
NODE_ENV=production

# ─── SECURITY & AUTHENTICATION ───
# Generate secure, high-entropy keys for production (e.g., openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# ─── CORS SETTINGS ───
# Comma-separated list of allowed origins. Do NOT hardcode servers in the codebase.
CORS_ORIGIN=http://localhost:5173,http://localhost

# ─── FRONTEND API CLIENT CONFIGURATION ───
# Accessed via Vite's import.meta.env.VITE_API_URL / VITE_SOCKET_URL
VITE_API_URL=/api
VITE_SOCKET_URL=
