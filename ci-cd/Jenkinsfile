pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'your-registry.com'
        IMAGE_TAG = "${BUILD_NUMBER}"
        ANSIBLE_DIR = 'infra/ansible'
        SLACK_CHANNEL = '#deployments'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install & Build') {
            parallel {
                stage('Frontend Build') {
                    steps {
                        dir('services/frontend') {
                            sh 'npm ci'
                            sh 'npm run build'
                        }
                    }
                }
                stage('Backend Dependencies') {
                    steps {
                        dir('services/backend/api') { sh 'npm ci --omit=dev' }
                    }
                }
            }
        }

        stage('Test') {
            steps {
                // Placeholder for unit/integration tests
                echo "Running unit tests..."
            }
        }

        stage('Build Docker Images') {
            parallel {
                stage('Frontend Image') {
                    steps {
                        sh "docker build -t ${DOCKER_REGISTRY}/inventory-frontend:${IMAGE_TAG} services/frontend/"
                    }
                }
                stage('Backend API Image') {
                    steps {
                        sh "docker build -t ${DOCKER_REGISTRY}/inventory-backend:${IMAGE_TAG} services/backend/api/"
                    }
                }
                stage('Inventory API Image') {
                    steps {
                        sh "docker build -t ${DOCKER_REGISTRY}/inventory-api:${IMAGE_TAG} services/backend/inventory-api/"
                    }
                }
                stage('Alert API Image') {
                    steps {
                        sh "docker build -t ${DOCKER_REGISTRY}/alert-api:${IMAGE_TAG} services/backend/alert-api/"
                    }
                }
            }
        }

        stage('Security Scan') {
            steps {
                // Scanning images using Trivy via Docker (No installation required on agent)
                sh "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy image --severity HIGH,CRITICAL ${DOCKER_REGISTRY}/inventory-backend:${IMAGE_TAG}"
                sh "docker run --rm -v /var/run/docker.sock:/var/run/docker.sock aquasec/trivy image --severity HIGH,CRITICAL ${DOCKER_REGISTRY}/inventory-frontend:${IMAGE_TAG}"
            }
        }

        stage('Push Images') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-creds', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh "echo $PASS | docker login ${DOCKER_REGISTRY} -u $USER --password-stdin"
                    sh "docker push ${DOCKER_REGISTRY}/inventory-frontend:${IMAGE_TAG}"
                    sh "docker push ${DOCKER_REGISTRY}/inventory-backend:${IMAGE_TAG}"
                    sh "docker push ${DOCKER_REGISTRY}/inventory-api:${IMAGE_TAG}"
                    sh "docker push ${DOCKER_REGISTRY}/alert-api:${IMAGE_TAG}"
                }
            }
        }

        stage('Deploy (Ansible + K8s)') {
            steps {
                // Using Ansible to update configuration and trigger deployment
                // Passing exact images built by this pipeline
                dir("${ANSIBLE_DIR}") {
                    sh "ansible-playbook -i inventory.ini setup-smart-inventory.yml --extra-vars 'image_tag=${IMAGE_TAG} docker_registry=${DOCKER_REGISTRY}'"
                }
                
                // K8s deployment as an alternative strategy
                sh "kubectl set image deployment/inventory-frontend frontend=${DOCKER_REGISTRY}/inventory-frontend:${IMAGE_TAG}"
                sh "kubectl set image deployment/inventory-backend backend=${DOCKER_REGISTRY}/inventory-backend:${IMAGE_TAG}"
                sh "kubectl set image deployment/inventory-api-service inventory-api=${DOCKER_REGISTRY}/inventory-api:${IMAGE_TAG}"
                sh "kubectl set image deployment/alert-api-service alert-api=${DOCKER_REGISTRY}/alert-api:${IMAGE_TAG}"
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline completed successfully!'
        }
        failure {
            echo '❌ Pipeline failed!'
            dir("${ANSIBLE_DIR}") {
                sh "ansible localhost -m debug -a 'msg=\"Pipeline Failed for Build ${BUILD_NUMBER}\"'"
            }
        }
    }
}
