## Frontend API base URL
# - For Docker + Nginx proxy (recommended): keep it as /api
# - For direct backend access in dev: http://localhost:5000/api
VITE_API_URL=/api
# ─── Frontend Environment Variables ───
# API base URL — defaults to /api for proxy routing
# Set to full URL (e.g., http://localhost:5000/api) only if bypassing proxy
VITE_API_URL=/api
